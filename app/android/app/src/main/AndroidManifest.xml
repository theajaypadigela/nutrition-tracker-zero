<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!--
    Exact alarms (Play-policy posture): we rely on SCHEDULE_EXACT_ALARM, which is grantable
    by the user and detectable at launch via notifee.getNotificationSettings().android.alarm.
    USE_EXACT_ALARM was REMOVED: it makes canScheduleExactAlarms() always true on Android 13+
    but is Play-policy-restricted to alarm/calendar apps and would be a launch blocker. The
    scheduler falls back to inexact (SET_AND_ALLOW_WHILE_IDLE) triggers when exact is not
    granted, and the reminder-health surface shows the "may be a few minutes late" state.
  -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!--
    The incoming call rings inside IncomingCallService (foregroundServiceType="phoneCall"), so the
    ring no longer depends on the full-screen Activity launching. The phoneCall type is permitted
    because the app holds MANAGE_OWN_CALLS (declared below). Required from Android 14 (API 34).
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <!--
    The in-call foreground service below (Daily's) keeps the microphone alive when the screen locks
    or the app is backgrounded mid-call. Required on Android 14+ for foregroundServiceType="microphone".
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!--
    Marks the app as a genuine "calling" app. Together with USE_FULL_SCREEN_INTENT and
    CallStyle (category=CALL) notifications this is the documented signature that keeps the
    full-screen-intent grant on Android 14+ (pair with the Play Console full-screen-intent
    declaration). We do NOT register a Telecom PhoneAccount / ConnectionService — the
    incoming-call UI is a self-drawn native Activity, so no call-log integration is implied.
  -->
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <!--
    Declared explicitly so Notifee's boot receiver re-arms alarm triggers after reboot.
    Previously this only existed via Notifee's manifest merge.
  -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:usesCleartextTraffic="true"
    android:supportsRtl="true">
    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:exported="true"
      android:showWhenLocked="true"
      android:turnScreenOn="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      Native full-screen incoming-call screen. Rendered in pure Kotlin (no React bridge) so it
      appears instantly over the lockscreen even when the app process was killed — no JS
      cold-start race. showWhenLocked/turnScreenOn draw it over the keyguard; a dedicated
      taskAffinity + excludeFromRecents keep it out of recents and isolated from MainActivity.
    -->
    <activity
      android:name=".incomingcall.IncomingCallActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:taskAffinity="com.nutritiontrackerzero.incomingcall"
      android:theme="@style/IncomingCallTheme"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode" />

    <!--
      Foreground service that owns a ringing call (CallStyle + full-screen notification, looping
      ringtone, 60s timeout). foregroundServiceType="phoneCall" is allowed because the app holds
      MANAGE_OWN_CALLS; it keeps the process alive so the ring works even when the full-screen
      Activity can't launch (Android 14+ FSI denied / background launch blocked).
    -->
    <service
      android:name=".incomingcall.IncomingCallService"
      android:exported="false"
      android:foregroundServiceType="phoneCall" />

    <!--
      Daily's ongoing-call foreground service. Daily starts it when a call connects and stops it when
      the call ends; without a declaration here Android logs "Unable to start service … not found" and
      the call is not protected from being cut off in the background. Its README shows
      "camera|microphone", but this app is audio-only and never asks for the camera, and Android 14+
      refuses a camera-type service without that permission, so it is declared microphone-only.
    -->
    <service
      android:name="com.daily.reactlibrary.DailyOngoingMeetingForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Handles Decline / Snooze actions on the call & missed notifications (works from background). -->
    <receiver
      android:name=".incomingcall.CallActionReceiver"
      android:exported="false" />
  </application>
</manifest>