<resources>

    <!-- Base application theme. The window background matches the app's own, so there is no
         white (or black) flash between launch and the first React Native frame. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- System dialogs (the time picker, alerts) take their accent from here. -->
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorAccent">@color/app_accent</item>
        <item name="colorControlActivated">@color/app_accent</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorPrimary">@color/app_accent</item>
    </style>

    <!--
      Theme for the native full-screen incoming-call screen (IncomingCallActivity). Light by default
      (dark status-bar icons); values-night/styles.xml is the dark counterpart. The layout draws
      everything itself, so only the window background and system bars are set here.
    -->
    <style name="IncomingCallTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/call_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/call_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
