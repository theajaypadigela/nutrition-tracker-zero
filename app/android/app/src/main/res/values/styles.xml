<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!--
      Theme for the native full-screen incoming-call screen (IncomingCallActivity). Dark,
      no action bar, so the call UI fully owns the screen over the lockscreen.
    -->
    <style name="IncomingCallTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/call_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/call_background</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
