<resources>

    <!-- The incoming-call theme in dark mode: light status-bar icons on the dark window. -->
    <style name="IncomingCallTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/call_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/call_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
