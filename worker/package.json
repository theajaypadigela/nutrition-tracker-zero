{
  "name": "nutrition-tracker-zero-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply nutrition-zero --local",
    "db:migrate:remote": "wrangler d1 migrations apply nutrition-zero --remote",
    "cf-typegen": "wrangler types",
    "fixtures:app": "esbuild scripts/make-app-fixtures.ts --bundle --platform=node --format=esm --outfile=/tmp/ntz-make-fixtures.mjs --log-level=warning && node /tmp/ntz-make-fixtures.mjs",
    "review:packet": "esbuild scripts/make-review-packet.ts --bundle --platform=node --format=esm --outfile=/tmp/ntz-review-packet.mjs --log-level=warning && node /tmp/ntz-review-packet.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@types/node": "^24.19.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
