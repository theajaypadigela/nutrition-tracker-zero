# Every secret/config name used by this repo. No values here, ever.

# Worker (worker/.dev.vars locally; `wrangler secret put APP_TOKEN` in production)
APP_TOKEN=

# Worker var (wrangler.jsonc, optional): overrides the request origin in Vapi webhook URLs
PUBLIC_BASE_URL=

# Deploy without `wrangler login` (shell only, never committed)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# App (app/src/config/local.ts, git-ignored)
API_BASE_URL=
# APP_TOKEN (same value as the Worker's)

# One-off migration (scripts/migrate-from-mongo, shell only)
MONGODB_URI=
